# Build context exclusions.
# Without these, `COPY . .` ships local node_modules (~400 MB) and any stale
# dist/ into the build context, which slows the build and risks baking local
# artifacts into the image.

node_modules
dist
.git
.gitignore
.DS_Store

# `scripts/` MUST stay in the build context: `npm run build` runs the prebuild
# hook, which calls scripts/generate-sitemap.mjs to regenerate sitemap.xml.
# Excluding it breaks the image build.
#
# Not needed to build or serve the site
.env
.env.*
*.log
npm-debug.log*

# Editor / OS noise
.vscode
.idea
.cursor
Dockerfile
.dockerignore
docker-compose.yml
README.md
