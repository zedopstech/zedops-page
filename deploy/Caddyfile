# Serves the built static site from /srv.
#
# Replaces `serve -s dist/public`, which could not express cache rules and
# returned HTTP 200 for every unknown URL (so /pricing and /anything-typoed
# looked like valid pages to crawlers).
{
	# No admin API: nothing outside this container needs to reload the config.
	admin off
}

:3000 {
	root * /srv

	# Cloudflare already brotlis at the edge (verified in production:
	# content-encoding: br), so zstd + gzip is enough here. Encoding twice just
	# burns CPU for no gain.
	encode zstd gzip

	# ── Cache policy ────────────────────────────────────────────────────────
	# Explicit and order-independent on purpose. An earlier version set an
	# unconditional `no-cache` default and tried to override it for /assets/*;
	# in practice the default won and every response - hashed assets included -
	# got no-cache. A second attempt with `defer` dropped the headers entirely.
	# Caddy's header-directive ordering is not something to rely on here, so this
	# states positively which paths are HTML instead.
	#
	# Why the default case matters: the SPA shell is served for every route that
	# has no file of its own (/solutions, /zed-ai, ...). A matcher like
	# `path *.html` misses all of them. If the shell is cacheable, a deploy deletes
	# the old hashed assets it points at and returning visitors get a blank page.

	# ── Content-addressed: cache for a year, immutable ───────────────────────
	# Two kinds of URL are addressed by their own content, so the bytes behind
	# them can never change and a returning visitor never needs to ask again:
	#
	#   /assets/*            Vite's own output (/assets/index-Ab12Cd.js)
	#   hashed media regex   what scripts/hash-assets.mjs produces, e.g.
	#                         /hero/hero-reel.67350de94d.mp4
	#
	# The regex is deliberately "hashed filename directly inside a media dir"
	# rather than a plain directory glob. /platform is both a media directory
	# (material-management.<hash>.png) and a route tree (/platform/module/core/
	# index.html), and a route's HTML must never be immutable: a deploy replaces
	# it in place, so caching it for a year would pin returning visitors to a
	# stale page. Requiring the 10-hex fingerprint excludes the routes, because
	# `[A-Za-z0-9_-]+` cannot cross a `/`.
	#
	# This is also the fix for the video problem: swapping public/hero/hero-reel.mp4
	# used to keep the same URL, so Cloudflare served the old bytes for the rest
	# of its TTL and the deploy had to be purged by hand. Now the bytes change, so
	# the URL changes, so a stale copy is unreachable.
	# One matcher, not a block: a bare `path_regexp` line inside a `@name { }`
	# block silently failed to match, so nothing here sent a Cache-Control at all
	# and every hashed file fell through uncached. Verified by running this
	# config against a real build and reading the headers back.
	@immutable path_regexp content_addressed ^/assets/|^/(hero|photos|screenshots|backgrounds|personas|industries|contractors|platform|team|video)/[A-Za-z0-9_-]+\.[0-9a-f]{10}\.(png|jpg|jpeg|webp|svg|mp4|webm|ico|woff2)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# ── Unhashed media: cache for a week, then revalidate ────────────────────
	# The brand and SEO files at the site root keep stable URLs on purpose.
	# og-image.png and logo.png are referenced by absolute URL from the Open Graph
	# tags and the Organization JSON-LD; a content-addressed URL there would give
	# schema.org a different logo identity on every change, and social scrapers
	# cache against whatever URL they were handed. They change about once a year,
	# so there is nothing to gain and an identity to lose.
	#
	# `.mp4` and `.webm` are listed because they were missing, which left
	# /video/schedule-demo-transparent.webm on Caddy's 4-hour default instead of
	# a week.
	@media {
		path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff2 *.mp4 *.webm
		not path_regexp content_addressed ^/assets/|^/(hero|photos|screenshots|backgrounds|personas|industries|contractors|platform|team|video)/[A-Za-z0-9_-]+\.[0-9a-f]{10}\.(png|jpg|jpeg|webp|svg|mp4|webm|ico|woff2)$
	}
	header @media Cache-Control "public, max-age=604800"

	# ── Everything else: the HTML shell, robots.txt, sitemap.xml ─────────────
	# Every route without a file of its own is served the shell here, so if this
	# were cacheable a deploy would leave returning visitors pointing at hashed
	# assets the new build no longer contains, and they would get a blank page.
	#
	# KEEP IN SYNC with MEDIA_DIRS in scripts/hash-assets.mjs. Adding a media
	# directory there without adding it here fails silently: the files are still
	# hashed and still serve correctly, they just fall through to the 7-day rule
	# instead of immutable, so nothing looks broken and nothing complains.
	# `team` was added to hash-assets.mjs and missed here - caught only by reading
	# the Cache-Control back off a production response.
	#
	# The three matchers above are mutually exclusive by construction - @media
	# excludes @immutable's regex, @shell excludes both - rather than relying on
	# Caddy applying same-directive header rules in a particular order. An
	# earlier version of this file depended on that ordering and lost.
	@shell {
		not path_regexp content_addressed ^/assets/|^/(hero|photos|screenshots|backgrounds|personas|industries|contractors|platform|team|video)/[A-Za-z0-9_-]+\.[0-9a-f]{10}\.(png|jpg|jpeg|webp|svg|mp4|webm|ico|woff2)$
		not path_regexp content_addressed ^/assets/|^/(hero|photos|screenshots|backgrounds|personas|industries|contractors|platform|team|video)/[A-Za-z0-9_-]+\.[0-9a-f]{10}\.(png|jpg|jpeg|webp|svg|mp4|webm|ico|woff2)$
		not path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff2 *.mp4 *.webm
	}
	header @shell Cache-Control "no-cache"

	# ── Routing ─────────────────────────────────────────────────────────────
	# Order matters:
	#   {path}                  -> a real file, e.g. /robots.txt, /og-image.png
	#   {path}/index.html       -> the prerendered route, e.g. /solutions/index.html
	#   /index.html             -> the SPA shell
	#
	# Note there is no /404.html in this list. If it were, try_files would resolve
	# the path and file_server would answer 200 - exactly the soft-404 we are
	# removing. Instead we let the lookup fail so Caddy raises a real 404, then
	# serve the branded page via handle_errors while keeping that status.
	@root path /
	handle @root {
		rewrite * /index.html
		file_server
	}

	try_files {path} {path}/index.html
	file_server

	# Branded 404 that keeps the 404 status. Anything that is not a prerendered
	# route and not a real file lands here, so /anything-typoed no longer looks
	# like a valid page to crawlers.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	# ── Security headers ────────────────────────────────────────────────────
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
