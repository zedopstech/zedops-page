# Analytics
# Google Analytics 4 measurement ID. Injected at build time by the
# googleAnalytics() plugin in vite.config.ts - not committed to source.
# Set as a repository secret named VITE_GA_ID for the deploy workflow.
VITE_GA_ID=

# Leads
# Strapi (zedops-kb-api) base URL that receives the contact, early access and roadmap forms.
# Local: run Strapi on :1337 and set http://localhost:1337. Production default is in src/lib/leads.ts.
VITE_LEADS_API_URL=
