# Cloudflare Pages headers for the ZedOps marketing site.
#
# Replaces the caching and security rules in deploy/Caddyfile, which cannot
# apply once the site is served by Pages. Those rules were:
#
#   content-hashed assets  -> Cache-Control: public, max-age=31536000, immutable
#   other media           -> Cache-Control: public, max-age=604800
#   the HTML shell        -> Cache-Control: no-cache
#   plus nosniff, referrer-policy, frame-options, HSTS, and -Server
#
# Losing the immutable rule on hashed assets would be the visible regression, so
# it is reproduced here exactly. Pages applies _headers to every response, and
# the first matching pattern wins, so the order below is deliberate: the most
# specific rule comes first.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media fingerprinted by scripts/hash-assets.mjs - name.<hash>.<ext>. Same
# reasoning as /assets: the content cannot change under a given name.
/hero/*
  Cache-Control: public, max-age=31536000, immutable

/photos/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/backgrounds/*
  Cache-Control: public, max-age=31536000, immutable

/personas/*
  Cache-Control: public, max-age=31536000, immutable

/industries/*
  Cache-Control: public, max-age=31536000, immutable

/contractors/*
  Cache-Control: public, max-age=31536000, immutable

/platform/*
  Cache-Control: public, max-age=31536000, immutable

/team/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted media: a week, not forever, because the name does not change
# when the content does.
/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

/*.woff2
  Cache-Control: public, max-age=604800

/*.mp4
  Cache-Control: public, max-age=604800

/*.webm
  Cache-Control: public, max-age=604800

# The HTML shell, and therefore every prerendered route. no-cache so a deploy is
# visible immediately - the same intent as the Caddyfile's @shell rule.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# -Server cannot be set from _headers. Cloudflare sets its own server header on
# Pages responses, and it is not configurable from the project. This is the one
# rule from the Caddyfile that does not carry over.
